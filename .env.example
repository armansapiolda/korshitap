# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# AI Provider Configuration ("vertex", "gemini", or "mock")
AI_PROVIDER=vertex
AI_MODEL=gemini-2.5-flash

# Google Cloud Vertex AI settings (if AI_PROVIDER=vertex)
USE_VERTEX_AI=true
GOOGLE_CLOUD_PROJECT=korshi-tap
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=./vertex_key.json

# Google AI Studio API Key (if AI_PROVIDER=gemini)
GEMINI_API_KEY=

# Database URL
DATABASE_URL=sqlite+aiosqlite:///korshi_tap.db

# Admin Web Panel
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8000
ADMIN_SECRET_KEY=korshi-tap-secret-key-change-in-production
# Login for /admin (HTTP Basic). If ADMIN_PASSWORD is empty, a one-time
# password is generated on every start and printed to the console.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# true = run_all.py fills an EMPTY database with 500 fake test profiles (seeds).
# Seeds can always be added/removed on /admin/seed instead.
SEED_DEMO_DATA_ON_START=false
